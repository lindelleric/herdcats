#!/usr/bin/env bash
# Print the suggested next semver for Herdcats based on conventional commits
# since the last herdcats-v* (or legacy herdrcat-v*) tag.
#
# Bump rules:
#   feat(scope)?:, or BREAKING CHANGE / <type>!:        -> minor
#   anything else (fix/perf/refactor/chore/docs/...)    -> patch
#
# Major bumps are never auto-suggested. Pass the version directly to
# bin/release when you want one. With no release tag yet, the version
# already in project.yml is suggested for the first release.
#
# Usage: ./ios/bin/next-version
set -euo pipefail

ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$ROOT"

resolve_release_tag() {
  local version="$1"
  if git rev-parse --verify "herdcats-v${version}" >/dev/null 2>&1; then
    echo "herdcats-v${version}"
  elif git rev-parse --verify "herdrcat-v${version}" >/dev/null 2>&1; then
    echo "herdrcat-v${version}"
  else
    return 1
  fi
}

# Newest release version among current and legacy prefixes. The prefix is
# stripped before sorting: version:refname would otherwise compare the full
# tag names and rank the two prefixes against each other (herdrcat-v0.3.1
# sorts as newer than herdcats-v0.3.2), suggesting an already-released
# version after the first publish under the new prefix.
LAST_VERSION="$(git tag --list 'herdcats-v*' 'herdrcat-v*' \
  | sed -E 's/^(herdcats|herdrcat)-v//' \
  | sort -u -t. -k1,1nr -k2,2nr -k3,3nr \
  | head -n 1)"

if [[ -z "$LAST_VERSION" ]]; then
  CURRENT="$(sed -n -E 's/^[[:space:]]*CFBundleShortVersionString:[[:space:]]*"?([^"]*)"?.*/\1/p' ios/project.yml | head -n 1)"
  echo "No herdcats-v* (or legacy herdrcat-v*) tag yet; this is the first release."
  echo ""
  echo "Suggested next version: ${CURRENT:-0.1.0}"
  exit 0
fi

LAST_TAG="$(resolve_release_tag "$LAST_VERSION")"
RANGE="${LAST_TAG}..HEAD"

if [[ -z "$(git log "$RANGE" --oneline -- ios/)" ]]; then
  echo "Error: no commits touching ios/ since $LAST_TAG - nothing to release." >&2
  exit 1
fi

SUBJECTS_AND_BODIES="$(git log "$RANGE" --pretty=format:'%s%n%b' -- ios/)"
SUBJECTS="$(git log "$RANGE" --pretty=format:'%s' -- ios/)"

BUMP=patch
if grep -qE '(^BREAKING CHANGE:|^[a-z]+(\([^)]+\))?!:)' <<< "$SUBJECTS_AND_BODIES" \
   || grep -qE '^feat(\([^)]+\))?:' <<< "$SUBJECTS"; then
  BUMP=minor
fi

echo "Unreleased commits since $LAST_TAG:"
while IFS= read -r line; do
  echo "  - $line"
done <<< "$SUBJECTS"
echo ""
echo -n "Suggested next version: "

IFS=. read -r MAJ MIN PAT <<< "$LAST_VERSION"
case "$BUMP" in
  minor) echo "${MAJ}.$((MIN + 1)).0" ;;
  patch) echo "${MAJ}.${MIN}.$((PAT + 1))" ;;
esac
